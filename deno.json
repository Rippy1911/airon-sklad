{
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run=deno,git scripts/build.ts",
    "check": "deno check src/worker.ts scripts/ tests/",
    "test": "deno test --allow-read --allow-env tests/",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@1.3.0",
    "@anthropic-ai/sdk/helpers/zod": "npm:@anthropic-ai/sdk@1.3.0/helpers/zod",
    "zod": "npm:zod@^4.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0"
  },
  "fmt": {
    "lineWidth": 110,
    "exclude": [
      "vendor/",
      "dist/",
      "public/fonts/",
      "node_modules/",
      "*.md"
    ]
  },
  "lint": {
    "exclude": [
      "vendor/",
      "dist/",
      "node_modules/"
    ]
  },
  "exclude": [
    "node_modules/",
    "dist/",
    "vendor/ns-ingredients/tests/"
  ],
  "nodeModulesDir": "none",
  "test": {
    "include": [
      "tests/"
    ]
  }
}
