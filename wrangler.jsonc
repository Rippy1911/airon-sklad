{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airon-sklad",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-01",
  // Only the custom domain: no *.workers.dev alias, no per-version preview hosts.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sklad.airon.app", "custom_domain": true }],
  // CSS, the photo script and the self-hosted fonts. The Worker answers everything else.
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": false },
  "vars": {
    "NS_FOOD_URL": "https://food.nextsolutions.studio",
    "PHOTO_DAILY_CAP": "300",
    "PHOTO_MODEL": "claude-haiku-5-5"
  },
  // Secrets (wrangler secret put): NS_FOOD_KEY, ANTHROPIC_API_KEY.
  "d1_databases": [
    { "binding": "DB", "database_name": "airon-sklad", "database_id": "90351f76-c4fb-45c9-b95b-bbc4c7441fe0", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    // Photo reads: 5 per minute per client address.
    { "name": "PHOTO_LIMIT", "namespace_id": "41811", "simple": { "limit": 5, "period": 60 } },
    // Pages and JSON: 60 per 10 s per client address, so a scraper can't spend the ns-food key.
    { "name": "PAGE_LIMIT", "namespace_id": "41812", "simple": { "limit": 60, "period": 10 } },
    // Search thumbnails (/img/{ean}): 120 per minute per client address; past it, the placeholder.
    { "name": "IMG_LIMIT", "namespace_id": "41813", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
